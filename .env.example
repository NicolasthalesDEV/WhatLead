# =============================================================================
# EXEMPLO DE CONFIGURAÇÃO DE AMBIENTE
# =============================================================================
# Copie este arquivo para .env.local (desenvolvimento) ou .env (produção)
# =============================================================================

# -----------------------------------------------------------------------------
# APP
# -----------------------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
SKIP_ENV_VALIDATION=false

# -----------------------------------------------------------------------------
# AUTENTICAÇÃO
# -----------------------------------------------------------------------------
# Gere com: openssl rand -hex 32
JWT_SECRET=change_me_super_secret_256bits

# -----------------------------------------------------------------------------
# BANCO DE DADOS - PostgreSQL
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://wacrm:wacrm@localhost:5432/wacrm?schema=public
DIRECT_URL=postgresql://wacrm:wacrm@localhost:5432/wacrm

# -----------------------------------------------------------------------------
# REDIS - Filas e Cache (Opcional)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
BULLMQ_PREFIX=wacrm

# -----------------------------------------------------------------------------
# WHATSAPP CLOUD API
# -----------------------------------------------------------------------------
# Documentação: https://developers.facebook.com/docs/whatsapp/cloud-api/get-started
# Para obter credenciais:
# 1. Acesse https://developers.facebook.com/apps
# 2. Crie um app do tipo "Business"
# 3. Adicione o produto "WhatsApp"
# 4. Configure um número de telefone
# 5. Gere um token de acesso permanente

# Para desenvolvimento, use valores 'dev' (stub mode - não envia mensagens reais)
# Para produção, configure valores reais do Meta Business

# ID do número de telefone do WhatsApp Business (obrigatório para produção)
# Exemplo: 123456789012345
WA_PHONE_NUMBER_ID=dev

# Token de acesso permanente da API (obrigatório para produção)
# Gere em: WhatsApp > API Setup > Permanent Token
WA_ACCESS_TOKEN=dev

# Token para validação de webhook (pode ser qualquer string)
# Use o mesmo valor ao configurar o webhook no Meta Business
WA_VERIFY_TOKEN=dev

# ID da conta do WhatsApp Business (opcional, para relatórios)
# Exemplo: 123456789012345
WA_BUSINESS_ACCOUNT_ID=dev

# Versão da API (opcional, padrão: v18.0)
WA_API_VERSION=v18.0

# IDs legados (podem ser removidos se não usados)
WA_BUSINESS_ID=dev
WA_APP_ID=dev
WA_APP_SECRET=dev
WA_DEFAULT_PHONE_NUMBER_ID=dev

# -----------------------------------------------------------------------------
# GATEWAY DE PAGAMENTO PIX
# -----------------------------------------------------------------------------
# Para desenvolvimento: fake
# Para produção: mercadopago, asaas, efi, pagarme
PSP_PROVIDER=fake

# Configure apenas o gateway que você escolher:

# Mercado Pago
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=

# Asaas
ASAAS_API_KEY=
ASAAS_WALLET_ID=

# Efí (ex-Gerencianet)
EFI_CLIENT_ID=
EFI_CLIENT_SECRET=
EFI_CERTIFICATE_PATH=
EFI_SANDBOX=false

# Pagar.me
PAGARME_API_KEY=

