generator client {
  provider        = "prisma-client-js"
  previewFeatures = []
  binaryTargets   = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Company {
  id                     String                   @id
  name                   String
  slug                   String                   @unique
  createdAt              DateTime                 @default(now())
  
  // Subscription fields
  plan                   String                   @default("free") // free, starter, professional, enterprise
  planStatus             String                   @default("active") // active, canceled, expired, trial
  planStartedAt          DateTime?
  planExpiresAt          DateTime?
  billingCycle           String?                  // monthly, yearly
  paymentMethod          String?                  // credit_card, mercadopago, pix
  mercadopagoCustomerId  String?
  mercadopagoSubscriptionId String?
  lastPaymentAt          DateTime?
  
  AuditLog               AuditLog[]
  Appointment            Appointment[]
  ChatbotAnalytics       ChatbotAnalytics[]
  ChatbotFlow            ChatbotFlow[]
  ChatbotSettings        ChatbotSettings?
  ChatbotTrigger         ChatbotTrigger[]
  Customer               Customer[]
  DailyMetric            DailyMetric[]
  FunnelCard             FunnelCard[]
  FunnelStage            FunnelStage[]
  GoogleCalendarToken    GoogleCalendarToken?
  Notification           Notification[]
  Order                  Order[]
  Payment                Payment[]
  Product                Product[]
  QuickResponse          QuickResponse[]
  Quote                  Quote[]
  User                   User[]
  WebhookEndpoint        WebhookEndpoint[]
  WhatsChannel           WhatsChannel[]
  WhatsMessage           WhatsMessage[]
}

model Customer {
  id           String         @id
  companyId    String
  name         String
  phoneE164    String         @unique
  email        String?
  tags         String[]
  createdAt    DateTime       @default(now())
  Company      Company        @relation(fields: [companyId], references: [id])
  Appointment  Appointment[]
  FunnelCard   FunnelCard[]
  Order        Order[]
  Quote        Quote[]
  WhatsMessage WhatsMessage[]
}

model FunnelStage {
  id         String       @id
  companyId  String
  name       String
  order      Int
  default    Boolean      @default(false)
  createdAt  DateTime     @default(now())
  Company    Company      @relation(fields: [companyId], references: [id])
  FunnelCard FunnelCard[]
}

model FunnelCard {
  id           String      @id
  companyId    String
  stageId      String
  customerId   String
  title        String
  description  String?
  value        Int?
  probability  Int         @default(50)
  tags         String[]
  assignedToId String?
  position     Int
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  Company      Company     @relation(fields: [companyId], references: [id])
  Stage        FunnelStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  Customer     Customer    @relation(fields: [customerId], references: [id])
  AssignedTo   User?       @relation(fields: [assignedToId], references: [id])

  @@index([companyId])
  @@index([stageId])
  @@index([customerId])
}

model DailyMetric {
  id                 String   @id
  companyId          String
  date               DateTime
  totalOrders        Int      @default(0)
  totalRevenue       Int      @default(0)
  averageOrderValue  Float    @default(0)
  newCustomers       Int      @default(0)
  quotesCreated      Int      @default(0)
  quotesAccepted     Int      @default(0)
  conversionRate     Float    @default(0)
  messagesReceived   Int      @default(0)
  messagesSent       Int      @default(0)
  responseTime       Float    @default(0)
  paymentsReceived   Int      @default(0)
  pixPayments        Int      @default(0)
  createdAt          DateTime @default(now())
  Company            Company  @relation(fields: [companyId], references: [id])

  @@unique([companyId, date])
  @@index([companyId])
  @@index([date])
}

model NPSResponse {
  id         String   @id
  surveyId   String
  customerId String
  score      Int
  comment    String?
  createdAt  DateTime @default(now())
}

model NPSSurvey {
  id        String   @id
  companyId String
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Order {
  id         String      @id
  companyId  String
  customerId String
  quoteId    String?
  status     OrderStatus @default(PENDING)
  total      Int
  createdAt  DateTime    @default(now())
  Company    Company     @relation(fields: [companyId], references: [id])
  Customer   Customer    @relation(fields: [customerId], references: [id])
  Quote      Quote?      @relation(fields: [quoteId], references: [id])
  OrderItem  OrderItem[]
  Payment    Payment[]
}

model OrderItem {
  id         String  @id
  orderId    String
  productId  String
  qty        Int
  priceCents Int
  Order      Order   @relation(fields: [orderId], references: [id])
  Product    Product @relation(fields: [productId], references: [id])
}

model Payment {
  id        String        @id
  companyId String
  orderId   String
  provider  String
  status    PaymentStatus @default(PENDING)
  amount    Int
  chargeId  String?
  payload   Json?
  createdAt DateTime      @default(now())
  Company   Company       @relation(fields: [companyId], references: [id])
  Order     Order         @relation(fields: [orderId], references: [id])
}

model Price {
  id          String   @id
  productId   String
  currency    String   @default("BRL")
  amount      Int
  promoAmount Int?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  Product     Product  @relation(fields: [productId], references: [id])
}

model Product {
  id          String      @id
  companyId   String
  title       String
  slug        String
  description String?
  imageUrl    String?
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  OrderItem   OrderItem[]
  Price       Price[]
  Company     Company     @relation(fields: [companyId], references: [id])
  QuoteItem   QuoteItem[]
}

model Quote {
  id         String      @id
  companyId  String
  customerId String
  status     QuoteStatus @default(DRAFT)
  total      Int
  pdfUrl     String?
  createdAt  DateTime    @default(now())
  Order      Order[]
  Company    Company     @relation(fields: [companyId], references: [id])
  Customer   Customer    @relation(fields: [customerId], references: [id])
  QuoteItem  QuoteItem[]
}

model QuoteItem {
  id         String  @id
  quoteId    String
  productId  String
  qty        Int
  priceCents Int
  Product    Product @relation(fields: [productId], references: [id])
  Quote      Quote   @relation(fields: [quoteId], references: [id])
}

model Ticket {
  id         String   @id
  companyId  String
  customerId String
  title      String
  status     String
  priority   String
  assigneeId String?
  createdAt  DateTime @default(now())
}

model User {
  id                     String                   @id
  companyId              String
  email                  String                   @unique
  hash                   String
  role                   Role
  name                   String
  createdAt              DateTime                 @default(now())
  Company                Company                  @relation(fields: [companyId], references: [id])
  AuditLog               AuditLog[]
  FunnelCard             FunnelCard[]
  Notification           Notification[]
  NotificationPreference NotificationPreference[]
  Session                Session[]
}

model Session {
  id           String   @id
  userId       String
  refreshToken String   @unique
  accessToken  String?
  ipAddress    String?
  userAgent    String?
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime @default(now())
  User         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshToken])
}

model AuditLog {
  id         String   @id
  userId     String?
  companyId  String
  action     String
  resource   String
  resourceId String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  User       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  Company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([companyId])
  @@index([createdAt])
  @@index([action])
}

model Notification {
  id        String   @id
  userId    String
  companyId String
  type      String
  title     String
  message   String
  link      String?
  read      Boolean  @default(false)
  readAt    DateTime?
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  Company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([companyId])
  @@index([createdAt])
}

model NotificationPreference {
  id                 String   @id
  userId             String   @unique
  emailEnabled       Boolean  @default(true)
  pushEnabled        Boolean  @default(true)
  newOrderEnabled    Boolean  @default(true)
  newMessageEnabled  Boolean  @default(true)
  newPaymentEnabled  Boolean  @default(true)
  newCustomerEnabled Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  User               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ChatbotFlow {
  id                String              @id
  companyId         String
  name              String
  description       String?
  triggerType       String              @default("KEYWORD")
  triggerKeywords   String[]
  active            Boolean             @default(false)
  status            String              @default("DRAFT")
  priority          Int                 @default(0)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  Company           Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ChatbotExecution  ChatbotExecution[]
  ChatbotNode       ChatbotNode[]

  @@index([companyId])
  @@index([active])
  @@index([status])
}

model ChatbotNode {
  id          String   @id
  flowId      String
  type        String
  name        String   @default("")
  data        Json     @default("{}")
  position    Json     @default("{\"x\":0,\"y\":0}")
  connections Json     @default("[]")
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  ChatbotFlow ChatbotFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)

  @@index([flowId])
}

model ChatbotExecution {
  id           String      @id
  flowId       String
  customerId   String
  status       String
  startedAt    DateTime    @default(now())
  completedAt  DateTime?
  currentNode  String?
  context      Json?       @default("{}")
  variables    Json?       @default("{}")
  ChatbotFlow  ChatbotFlow @relation(fields: [flowId], references: [id])

  @@index([flowId])
  @@index([customerId])
  @@index([status])
}

model ChatbotTrigger {
  id          String   @id
  companyId   String
  flowId      String
  name        String
  type        String
  conditions  Json?
  enabled     Boolean  @default(true)
  priority    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  Company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([flowId])
  @@index([type])
  @@index([enabled])
}

model QuickResponse {
  id        String   @id
  companyId String
  shortcut  String
  message   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, shortcut])
  @@index([companyId])
}

model ChatbotAnalytics {
  id               String   @id
  companyId        String
  date             DateTime
  flowsExecuted    Int      @default(0)
  flowsCompleted   Int      @default(0)
  flowsFailed      Int      @default(0)
  avgExecutionTime Float    @default(0)
  ordersCreated    Int      @default(0)
  quotesCreated    Int      @default(0)
  createdAt        DateTime @default(now())
  Company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, date])
  @@index([companyId])
  @@index([date])
}

model ChatbotSettings {
  id                    String   @id
  companyId             String   @unique
  // Identity
  botName               String   @default("Assistente")
  botEmoji              String   @default("🤖")
  language              String   @default("pt-BR")
  // Tone
  tone                  String   @default("friendly") // formal, informal, friendly, professional, fun
  // Behavior
  autoReplyEnabled      Boolean  @default(true)
  typingDelay           Int      @default(1500)  // ms between messages
  sessionTimeoutMinutes Int      @default(30)
  maxMessagesPerSession Int      @default(50)
  // Messages
  welcomeMessage        String?  @default("Olá! Como posso ajudar você hoje? 😊")
  farewellMessage       String?  @default("Obrigado pelo contato! Até logo! 👋")
  unknownCommandMessage String?  @default("Desculpe, não entendi. Poderia reformular sua pergunta?")
  offHoursEnabled       Boolean  @default(false)
  offHoursMessage       String?  @default("Estamos fora do horário de atendimento. Retornaremos em breve!")
  // Business hours used for off-hours
  businessHoursStart    String   @default("08:00")
  businessHoursEnd      String   @default("18:00")
  businessDays          String[] @default(["MON","TUE","WED","THU","FRI"])
  // Human handoff
  handoffEnabled        Boolean  @default(true)
  handoffKeyword        String   @default("humano")
  handoffMessage        String?  @default("Transferindo para um atendente humano...")
  // Agent personality & context
  agentPersonality      String?                          // e.g. "Extrovertida, curiosa, usa humor leve"
  agentContext          String?                          // Company/product context injected into system prompt
  responseLength        String   @default("normal")     // brief | normal | detailed
  // OpenAI AI mode
  openAIEnabled         Boolean  @default(false)
  openAIModel           String   @default("gpt-4o-mini")
  openAISystemPrompt    String?                          // Full custom system prompt (overrides auto-built one)
  openAITemperature     Float    @default(0.7)           // 0.0 = deterministic, 1.0 = very creative
  openAIMaxTokens       Int      @default(512)           // Max tokens per GPT response
  openAIContextMessages Int      @default(10)            // How many previous messages to send as history
  // ElevenLabs TTS for voice replies
  elevenLabsEnabled     Boolean  @default(false)
  elevenLabsVoiceId     String?
  elevenLabsModel       String   @default("eleven_multilingual_v2")
  elevenLabsStability   Float    @default(0.5)           // 0–1: lower = more expressive
  elevenLabsSimilarity  Float    @default(0.75)          // 0–1: voice similarity boost
  elevenLabsStyle       Float    @default(0.0)           // 0–1: style exaggeration
  // Per-company API keys (override global env vars)
  openaiApiKey          String?                          // Encrypted at rest via DB
  elevenLabsApiKey      String?
  // Timestamps
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  Company               Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

// XI – Agenda interna
model Appointment {
  id              String    @id
  companyId       String
  customerId      String?
  userId          String?   // assigned staff member
  title           String
  description     String?
  startAt         DateTime
  endAt           DateTime
  allDay          Boolean   @default(false)
  status          String    @default("SCHEDULED") // SCHEDULED, CONFIRMED, CANCELLED, DONE
  location        String?
  notes           String?
  // Google Calendar sync
  googleEventId   String?
  googleCalendarId String?
  syncedAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  Company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  Customer        Customer? @relation(fields: [customerId], references: [id])

  @@index([companyId])
  @@index([startAt])
  @@index([customerId])
}

model GoogleCalendarToken {
  id            String   @id
  companyId     String   @unique
  accessToken   String
  refreshToken  String?
  expiresAt     DateTime?
  scope         String?
  tokenType     String   @default("Bearer")
  calendarId    String   @default("primary")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  Company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model WebhookDelivery {
  id         String   @id
  endpointId String
  eventType  String
  payload    Json
  status     String
  attempt    Int      @default(0)
  createdAt  DateTime @default(now())
}

model WebhookEndpoint {
  id        String   @id
  companyId String
  url       String
  secret    String
  active    Boolean  @default(true)
  events    String[]
  createdAt DateTime @default(now())
  Company   Company  @relation(fields: [companyId], references: [id])
}

model WhatsChannel {
  id            String         @id
  companyId     String
  phoneNumberId String         @unique
  waAccessToken String
  waBusinessId  String
  displayName   String
  status        String
  createdAt     DateTime       @default(now())
  Company       Company        @relation(fields: [companyId], references: [id])
  WhatsMessage  WhatsMessage[]
}

model WhatsMessage {
  id           String           @id
  companyId    String
  customerId   String
  channelId    String
  direction    MessageDirection
  type         String
  body         String?
  templateName String?
  status       String
  raw          Json?
  createdAt    DateTime         @default(now())
  WhatsChannel WhatsChannel     @relation(fields: [channelId], references: [id])
  Company      Company          @relation(fields: [companyId], references: [id])
  Customer     Customer         @relation(fields: [customerId], references: [id])
}

enum MessageDirection {
  IN
  OUT
}

enum OrderStatus {
  PENDING
  AWAITING_PAYMENT
  PAID
  CANCELED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  EXPIRED
  FAILED
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  EXPIRED
}

enum Role {
  OWNER
  ADMIN
  SELLER
  SUPPORT
}
