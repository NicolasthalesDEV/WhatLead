generator client {
  provider        = "prisma-client-js"
  previewFeatures = []
  binaryTargets   = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model ApiUsageLog {
  id          String   @id
  companyId   String
  provider    String
  operation   String
  inputUnits  Int      @default(0)
  outputUnits Int      @default(0)
  costUsd     Float    @default(0)
  model       String?
  customerId  String?
  createdAt   DateTime @default(now())
  Company     Company  @relation(fields: [companyId], references: [id])

  @@index([companyId, createdAt])
  @@index([companyId])
  @@index([companyId, provider])
}

model Appointment {
  id               String    @id
  companyId        String
  customerId       String?
  userId           String?
  title            String
  description      String?
  startAt          DateTime
  endAt            DateTime
  allDay           Boolean   @default(false)
  status           String    @default("SCHEDULED")
  location         String?
  notes            String?
  googleEventId    String?
  googleCalendarId String?
  syncedAt         DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime
  Company          Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  Customer         Customer? @relation(fields: [customerId], references: [id])

  @@index([companyId])
  @@index([customerId])
  @@index([startAt])
}

model AuditLog {
  id         String   @id
  userId     String?
  companyId  String
  action     String
  resource   String
  resourceId String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  Company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  User       User?    @relation(fields: [userId], references: [id])

  @@index([action])
  @@index([companyId])
  @@index([createdAt])
  @@index([userId])
}

model ChatbotAnalytics {
  id               String   @id
  companyId        String
  date             DateTime
  flowsExecuted    Int      @default(0)
  flowsCompleted   Int      @default(0)
  flowsFailed      Int      @default(0)
  avgExecutionTime Float    @default(0)
  ordersCreated    Int      @default(0)
  quotesCreated    Int      @default(0)
  createdAt        DateTime @default(now())
  Company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, date])
  @@index([companyId])
  @@index([date])
}

model ChatbotExecution {
  id          String      @id
  flowId      String
  customerId  String
  status      String
  startedAt   DateTime    @default(now())
  completedAt DateTime?
  currentNode String?
  variables   Json?       @default("{}")
  context     Json?       @default("{}")
  ChatbotFlow ChatbotFlow @relation(fields: [flowId], references: [id])

  @@index([customerId])
  @@index([flowId])
  @@index([status])
}

model ChatbotFlow {
  id               String             @id
  companyId        String
  name             String
  description      String?
  triggerType      String             @default("KEYWORD")
  triggerKeywords  String[]
  active           Boolean            @default(false)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime
  priority         Int                @default(0)
  status           String             @default("DRAFT")
  ChatbotExecution ChatbotExecution[]
  Company          Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ChatbotNode      ChatbotNode[]

  @@index([active])
  @@index([companyId])
  @@index([status])
}

model ChatbotNode {
  id          String      @id
  flowId      String
  type        String
  name        String      @default("")
  position    Json        @default("{\"x\": 0, \"y\": 0}")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime
  connections Json        @default("[]")
  data        Json        @default("{}")
  order       Int         @default(0)
  ChatbotFlow ChatbotFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)

  @@index([flowId])
}

model ChatbotSettings {
  id                    String   @id
  companyId             String   @unique
  botName               String   @default("Assistente")
  botEmoji              String   @default("🤖")
  language              String   @default("pt-BR")
  tone                  String   @default("friendly")
  autoReplyEnabled      Boolean  @default(true)
  typingDelay           Int      @default(1500)
  sessionTimeoutMinutes Int      @default(30)
  maxMessagesPerSession Int      @default(50)
  welcomeMessage        String?  @default("Olá! Como posso ajudar você hoje? 😊")
  farewellMessage       String?  @default("Obrigado pelo contato! Até logo! 👋")
  unknownCommandMessage String?  @default("Desculpe, não entendi. Poderia reformular sua pergunta?")
  offHoursEnabled       Boolean  @default(false)
  offHoursMessage       String?  @default("Estamos fora do horário de atendimento. Retornaremos em breve!")
  businessHoursStart    String   @default("08:00")
  businessHoursEnd      String   @default("18:00")
  businessDays          String[] @default(["MON", "TUE", "WED", "THU", "FRI"])
  handoffEnabled        Boolean  @default(true)
  handoffKeyword        String   @default("humano")
  handoffMessage        String?  @default("Transferindo para um atendente humano...")
  createdAt             DateTime @default(now())
  updatedAt             DateTime
  elevenLabsEnabled     Boolean  @default(false)
  elevenLabsVoiceId     String?
  openAIEnabled         Boolean  @default(false)
  openAIModel           String   @default("gpt-4o-mini")
  openAISystemPrompt    String?
  agentContext          String?
  agentPersonality      String?
  elevenLabsModel       String   @default("eleven_multilingual_v2")
  elevenLabsSimilarity  Float    @default(0.75)
  elevenLabsStability   Float    @default(0.5)
  elevenLabsStyle       Float    @default(0.0)
  openAIContextMessages Int      @default(10)
  openAIMaxTokens       Int      @default(512)
  openAITemperature     Float    @default(0.7)
  responseLength        String   @default("normal")
  elevenLabsApiKey      String?
  openaiApiKey          String?
  Company               Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model ChatbotTrigger {
  id         String   @id
  companyId  String
  flowId     String
  name       String
  type       String
  conditions Json?
  enabled    Boolean  @default(true)
  priority   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime
  Company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([enabled])
  @@index([flowId])
  @@index([type])
}

model Company {
  id                        String               @id
  name                      String
  slug                      String               @unique
  createdAt                 DateTime             @default(now())
  plan                      String               @default("free")
  planStatus                String               @default("active")
  planStartedAt             DateTime?
  planExpiresAt             DateTime?
  billingCycle              String?
  paymentMethod             String?
  mercadopagoCustomerId     String?
  mercadopagoSubscriptionId String?
  lastPaymentAt             DateTime?
  updatedAt                 DateTime             @default(now())
  email                     String?
  phone                     String?
  website                   String?
  address                   String?
  city                      String?
  state                     String?
  zipCode                   String?
  country                   String?              @default("BR")
  document                  String?
  logoUrl                   String?
  description               String?
  businessHours             Json?
  autoMessages              Json?
  ApiUsageLog               ApiUsageLog[]
  Appointment               Appointment[]
  AuditLog                  AuditLog[]
  ChatbotAnalytics          ChatbotAnalytics[]
  ChatbotFlow               ChatbotFlow[]
  ChatbotSettings           ChatbotSettings?
  ChatbotTrigger            ChatbotTrigger[]
  Customer                  Customer[]
  DailyMetric               DailyMetric[]
  FunnelCard                FunnelCard[]
  FunnelStage               FunnelStage[]
  GoogleCalendarToken       GoogleCalendarToken?
  NPSSurvey                 NPSSurvey[]
  Notification              Notification[]
  Order                     Order[]
  Payment                   Payment[]
  Product                   Product[]
  QuickResponse             QuickResponse[]
  Quote                     Quote[]
  Ticket                    Ticket[]
  User                      User[]
  WebhookEndpoint           WebhookEndpoint[]
  WhatsChannel              WhatsChannel[]
  WhatsMessage              WhatsMessage[]
}

model Customer {
  id           String         @id
  companyId    String
  name         String
  phoneE164    String         @unique
  email        String?
  tags         String[]
  createdAt    DateTime       @default(now())
  Appointment  Appointment[]
  Company      Company        @relation(fields: [companyId], references: [id])
  FunnelCard   FunnelCard[]
  Order        Order[]
  Quote        Quote[]
  Ticket       Ticket[]
  WhatsMessage WhatsMessage[]

  @@index([companyId])
  @@index([companyId, name])
}

model DailyMetric {
  id                String   @id
  companyId         String
  date              DateTime
  totalOrders       Int      @default(0)
  totalRevenue      Int      @default(0)
  averageOrderValue Float    @default(0)
  newCustomers      Int      @default(0)
  quotesCreated     Int      @default(0)
  quotesAccepted    Int      @default(0)
  conversionRate    Float    @default(0)
  messagesReceived  Int      @default(0)
  messagesSent      Int      @default(0)
  responseTime      Float    @default(0)
  paymentsReceived  Int      @default(0)
  pixPayments       Int      @default(0)
  createdAt         DateTime @default(now())
  Company           Company  @relation(fields: [companyId], references: [id])

  @@unique([companyId, date])
  @@index([companyId])
  @@index([date])
}

model FunnelCard {
  id           String      @id
  companyId    String
  stageId      String
  customerId   String
  title        String
  description  String?
  value        Int?
  probability  Int         @default(50)
  tags         String[]
  assignedToId String?
  position     Int
  createdAt    DateTime    @default(now())
  updatedAt    DateTime
  User         User?       @relation(fields: [assignedToId], references: [id])
  Company      Company     @relation(fields: [companyId], references: [id])
  Customer     Customer    @relation(fields: [customerId], references: [id])
  FunnelStage  FunnelStage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([customerId])
  @@index([stageId])
}

model FunnelStage {
  id         String       @id
  companyId  String
  name       String
  order      Int
  default    Boolean      @default(false)
  createdAt  DateTime     @default(now())
  FunnelCard FunnelCard[]
  Company    Company      @relation(fields: [companyId], references: [id])
}

model GoogleCalendarToken {
  id           String    @id
  companyId    String    @unique
  accessToken  String
  refreshToken String?
  expiresAt    DateTime?
  scope        String?
  tokenType    String    @default("Bearer")
  calendarId   String    @default("primary")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime
  Company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model NPSResponse {
  id         String    @id
  surveyId   String
  customerId String
  score      Int
  comment    String?
  createdAt  DateTime  @default(now())
  NPSSurvey  NPSSurvey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([surveyId])
}

model NPSSurvey {
  id          String        @id
  companyId   String
  name        String
  active      Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @default(now())
  NPSResponse NPSResponse[]
  Company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model Notification {
  id        String    @id
  userId    String
  companyId String
  type      String
  title     String
  message   String
  link      String?
  read      Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())
  Company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  User      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([createdAt])
  @@index([userId, read])
}

model NotificationPreference {
  id                 String   @id
  userId             String   @unique
  emailEnabled       Boolean  @default(true)
  pushEnabled        Boolean  @default(true)
  newOrderEnabled    Boolean  @default(true)
  newMessageEnabled  Boolean  @default(true)
  newPaymentEnabled  Boolean  @default(true)
  newCustomerEnabled Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime
  User               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Order {
  id         String      @id
  companyId  String
  customerId String
  quoteId    String?
  status     OrderStatus @default(PENDING)
  total      Int
  createdAt  DateTime    @default(now())
  Company    Company     @relation(fields: [companyId], references: [id])
  Customer   Customer    @relation(fields: [customerId], references: [id])
  Quote      Quote?      @relation(fields: [quoteId], references: [id])
  OrderItem  OrderItem[]
  Payment    Payment[]
}

model OrderItem {
  id         String  @id
  orderId    String
  productId  String
  qty        Int
  priceCents Int
  Order      Order   @relation(fields: [orderId], references: [id])
  Product    Product @relation(fields: [productId], references: [id])
}

model Payment {
  id        String        @id
  companyId String
  orderId   String
  provider  String
  status    PaymentStatus @default(PENDING)
  amount    Int
  chargeId  String?
  payload   Json?
  createdAt DateTime      @default(now())
  Company   Company       @relation(fields: [companyId], references: [id])
  Order     Order         @relation(fields: [orderId], references: [id])
}

model Price {
  id          String   @id
  productId   String
  currency    String   @default("BRL")
  amount      Int
  promoAmount Int?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  Product     Product  @relation(fields: [productId], references: [id])
}

model Product {
  id          String      @id
  companyId   String
  title       String
  slug        String
  description String?
  imageUrl    String?
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  OrderItem   OrderItem[]
  Price       Price[]
  Company     Company     @relation(fields: [companyId], references: [id])
  QuoteItem   QuoteItem[]
}

model QuickResponse {
  id        String   @id
  companyId String
  shortcut  String
  message   String
  createdAt DateTime @default(now())
  updatedAt DateTime
  Company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, shortcut])
  @@index([companyId])
}

model Quote {
  id         String      @id
  companyId  String
  customerId String
  status     QuoteStatus @default(DRAFT)
  total      Int
  pdfUrl     String?
  createdAt  DateTime    @default(now())
  Order      Order[]
  Company    Company     @relation(fields: [companyId], references: [id])
  Customer   Customer    @relation(fields: [customerId], references: [id])
  QuoteItem  QuoteItem[]
}

model QuoteItem {
  id         String  @id
  quoteId    String
  productId  String
  qty        Int
  priceCents Int
  Product    Product @relation(fields: [productId], references: [id])
  Quote      Quote   @relation(fields: [quoteId], references: [id])
}

model Session {
  id           String    @id
  userId       String
  refreshToken String    @unique
  accessToken  String?
  ipAddress    String?
  userAgent    String?
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())
  User         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([refreshToken])
  @@index([userId])
}

model Ticket {
  id                             String          @id
  companyId                      String
  customerId                     String
  subject                        String
  status                         String          @default("open")
  priority                       String          @default("medium")
  assignedToId                   String?
  createdAt                      DateTime        @default(now())
  description                    String?
  category                       String          @default("general")
  tags                           String[]        @default([])
  createdById                    String?
  slaDeadline                    DateTime?
  closedAt                       DateTime?
  updatedAt                      DateTime        @default(now())
  User_Ticket_assignedToIdToUser User?           @relation("Ticket_assignedToIdToUser", fields: [assignedToId], references: [id])
  Company                        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  User_Ticket_createdByIdToUser  User?           @relation("Ticket_createdByIdToUser", fields: [createdById], references: [id])
  Customer                       Customer        @relation(fields: [customerId], references: [id])
  TicketComment                  TicketComment[]

  @@index([assignedToId])
  @@index([companyId])
  @@index([customerId])
  @@index([status])
}

model TicketComment {
  id        String   @id
  ticketId  String
  userId    String
  body      String
  createdAt DateTime @default(now())
  Ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  User      User     @relation(fields: [userId], references: [id])

  @@index([ticketId])
}

model User {
  id                               String                  @id
  companyId                        String
  email                            String                  @unique
  hash                             String
  role                             Role
  name                             String
  createdAt                        DateTime                @default(now())
  phone                            String?
  AuditLog                         AuditLog[]
  FunnelCard                       FunnelCard[]
  Notification                     Notification[]
  NotificationPreference           NotificationPreference?
  Session                          Session[]
  Ticket_Ticket_assignedToIdToUser Ticket[]                @relation("Ticket_assignedToIdToUser")
  Ticket_Ticket_createdByIdToUser  Ticket[]                @relation("Ticket_createdByIdToUser")
  TicketComment                    TicketComment[]
  Company                          Company                 @relation(fields: [companyId], references: [id])
}

model WebhookDelivery {
  id         String   @id
  endpointId String
  eventType  String
  payload    Json
  status     String
  attempt    Int      @default(0)
  createdAt  DateTime @default(now())
}

model WebhookEndpoint {
  id        String   @id
  companyId String
  url       String
  secret    String
  active    Boolean  @default(true)
  events    String[]
  createdAt DateTime @default(now())
  Company   Company  @relation(fields: [companyId], references: [id])
}

model WhatsChannel {
  id            String         @id
  companyId     String
  phoneNumberId String         @unique
  waAccessToken String
  waBusinessId  String
  displayName   String
  status        String
  createdAt     DateTime       @default(now())
  Company       Company        @relation(fields: [companyId], references: [id])
  WhatsMessage  WhatsMessage[]
}

model WhatsMessage {
  id           String           @id
  companyId    String
  customerId   String
  channelId    String
  direction    MessageDirection
  type         String
  body         String?
  templateName String?
  status       String
  raw          Json?
  createdAt    DateTime         @default(now())
  WhatsChannel WhatsChannel     @relation(fields: [channelId], references: [id])
  Company      Company          @relation(fields: [companyId], references: [id])
  Customer     Customer         @relation(fields: [customerId], references: [id])

  @@index([companyId, createdAt(sort: Desc)])
  @@index([companyId, customerId, createdAt(sort: Desc)])
  @@index([companyId, direction, status])
}

enum MessageDirection {
  IN
  OUT
}

enum OrderStatus {
  PENDING
  AWAITING_PAYMENT
  PAID
  CANCELED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  EXPIRED
  FAILED
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  EXPIRED
}

enum Role {
  OWNER
  ADMIN
  SELLER
  SUPPORT
}
