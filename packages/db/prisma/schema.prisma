generator client {
  provider        = "prisma-client-js"
  previewFeatures = []
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Company {
  id              String            @id
  name            String
  slug            String            @unique
  createdAt       DateTime          @default(now())
  Customer        Customer[]
  FunnelStage     FunnelStage[]
  Order           Order[]
  Payment         Payment[]
  Product         Product[]
  Quote           Quote[]
  User            User[]
  WebhookEndpoint WebhookEndpoint[]
  WhatsChannel    WhatsChannel[]
  WhatsMessage    WhatsMessage[]
}

model Customer {
  id           String         @id
  companyId    String
  name         String
  phoneE164    String         @unique
  email        String?
  tags         String[]
  createdAt    DateTime       @default(now())
  Company      Company        @relation(fields: [companyId], references: [id])
  Order        Order[]
  Quote        Quote[]
  WhatsMessage WhatsMessage[]
}

model FunnelStage {
  id        String  @id
  companyId String
  name      String
  order     Int
  default   Boolean @default(false)
  Company   Company @relation(fields: [companyId], references: [id])
}

model NPSResponse {
  id         String   @id
  surveyId   String
  customerId String
  score      Int
  comment    String?
  createdAt  DateTime @default(now())
}

model NPSSurvey {
  id        String   @id
  companyId String
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Order {
  id         String      @id
  companyId  String
  customerId String
  quoteId    String?
  status     OrderStatus @default(PENDING)
  total      Int
  createdAt  DateTime    @default(now())
  Company    Company     @relation(fields: [companyId], references: [id])
  Customer   Customer    @relation(fields: [customerId], references: [id])
  Quote      Quote?      @relation(fields: [quoteId], references: [id])
  OrderItem  OrderItem[]
  Payment    Payment[]
}

model OrderItem {
  id         String  @id
  orderId    String
  productId  String
  qty        Int
  priceCents Int
  Order      Order   @relation(fields: [orderId], references: [id])
  Product    Product @relation(fields: [productId], references: [id])
}

model Payment {
  id        String        @id
  companyId String
  orderId   String
  provider  String
  status    PaymentStatus @default(PENDING)
  amount    Int
  chargeId  String?
  payload   Json?
  createdAt DateTime      @default(now())
  Company   Company       @relation(fields: [companyId], references: [id])
  Order     Order         @relation(fields: [orderId], references: [id])
}

model Price {
  id          String   @id
  productId   String
  currency    String   @default("BRL")
  amount      Int
  promoAmount Int?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  Product     Product  @relation(fields: [productId], references: [id])
}

model Product {
  id          String      @id
  companyId   String
  title       String
  slug        String
  description String?
  imageUrl    String?
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  OrderItem   OrderItem[]
  Price       Price[]
  Company     Company     @relation(fields: [companyId], references: [id])
  QuoteItem   QuoteItem[]
}

model Quote {
  id         String      @id
  companyId  String
  customerId String
  status     QuoteStatus @default(DRAFT)
  total      Int
  pdfUrl     String?
  createdAt  DateTime    @default(now())
  Order      Order[]
  Company    Company     @relation(fields: [companyId], references: [id])
  Customer   Customer    @relation(fields: [customerId], references: [id])
  QuoteItem  QuoteItem[]
}

model QuoteItem {
  id         String  @id
  quoteId    String
  productId  String
  qty        Int
  priceCents Int
  Product    Product @relation(fields: [productId], references: [id])
  Quote      Quote   @relation(fields: [quoteId], references: [id])
}

model Ticket {
  id         String   @id
  companyId  String
  customerId String
  title      String
  status     String
  priority   String
  assigneeId String?
  createdAt  DateTime @default(now())
}

model User {
  id        String   @id
  companyId String
  email     String   @unique
  hash      String
  role      Role
  name      String
  createdAt DateTime @default(now())
  Company   Company  @relation(fields: [companyId], references: [id])
}

model WebhookDelivery {
  id         String   @id
  endpointId String
  eventType  String
  payload    Json
  status     String
  attempt    Int      @default(0)
  createdAt  DateTime @default(now())
}

model WebhookEndpoint {
  id        String   @id
  companyId String
  url       String
  secret    String
  active    Boolean  @default(true)
  events    String[]
  createdAt DateTime @default(now())
  Company   Company  @relation(fields: [companyId], references: [id])
}

model WhatsChannel {
  id            String         @id
  companyId     String
  phoneNumberId String         @unique
  waAccessToken String
  waBusinessId  String
  displayName   String
  status        String
  createdAt     DateTime       @default(now())
  Company       Company        @relation(fields: [companyId], references: [id])
  WhatsMessage  WhatsMessage[]
}

model WhatsMessage {
  id           String           @id
  companyId    String
  customerId   String
  channelId    String
  direction    MessageDirection
  type         String
  body         String?
  templateName String?
  status       String
  raw          Json?
  createdAt    DateTime         @default(now())
  WhatsChannel WhatsChannel     @relation(fields: [channelId], references: [id])
  Company      Company          @relation(fields: [companyId], references: [id])
  Customer     Customer         @relation(fields: [customerId], references: [id])
}

enum MessageDirection {
  IN
  OUT
}

enum OrderStatus {
  PENDING
  AWAITING_PAYMENT
  PAID
  CANCELED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  EXPIRED
  FAILED
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  EXPIRED
}

enum Role {
  OWNER
  ADMIN
  SELLER
  SUPPORT
}
